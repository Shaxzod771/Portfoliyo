# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
# For GitHub Actions deploys, add the same name as a repository variable (Settings → Secrets and variables → Actions → Variables).

# Address of the PHP backend (backend/public), e.g. http://api.partfoliyo.local
# Leave empty: the site uses its built-in project list and sends the contact form through FormSubmit.
# The admin panel (admin.html) needs it.
VITE_API_URL=
